{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/annotation-assistant/v0.1/schemas/proposal.schema.json",
  "title": "proposal",
  "description": "Offline structural contract; it does not run computation, authenticate a session or produce human judgments. Cross-object and permission guards require separate validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "$ref": "common.schema.json#/$defs/record_kind"
    },
    "execution_enabled": {
      "type": "boolean"
    },
    "proposal_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_contract_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issue_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issue_revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "catalogue_revision_at_creation": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "input_versions": {
      "$ref": "common.schema.json#/$defs/input_versions"
    },
    "result_ids": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "observation_ids": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "protocol_refs": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "review_ids": {
      "$ref": "common.schema.json#/$defs/nonempty_ids"
    },
    "eligible_change_ids": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "bundle_ids": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suggestion_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "comparison_order",
              "candidate_partition",
              "protocol_next_step",
              "missing_information"
            ]
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "source_ids": {
            "$ref": "common.schema.json#/$defs/ids"
          },
          "item_ids": {
            "$ref": "common.schema.json#/$defs/ids"
          }
        },
        "required": [
          "suggestion_id",
          "kind",
          "text",
          "source_ids",
          "item_ids"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "prepared",
        "displayed",
        "superseded",
        "withdrawn"
      ]
    },
    "created_by": {
      "enum": [
        "assistant",
        "operator",
        "system"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "final_label_assertions": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "execution_enabled",
    "proposal_id",
    "task_contract_id",
    "issue_id",
    "issue_revision",
    "catalogue_revision_at_creation",
    "input_versions",
    "result_ids",
    "observation_ids",
    "protocol_refs",
    "review_ids",
    "eligible_change_ids",
    "bundle_ids",
    "suggestions",
    "status",
    "created_by",
    "created_at",
    "final_label_assertions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "engineering_simulation"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "execution_enabled": {
            "const": false
          }
        }
      }
    }
  ]
}
