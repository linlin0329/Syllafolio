{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/annotation-assistant/v0.1/schemas/human_observation.schema.json",
  "title": "human_observation",
  "description": "Offline structural contract. Schema validity does not establish authorization, execution, completed human judgment or scientific quality. Cross-object references, identity permissions, versions and state guards are checked separately by the offline semantic validator and runtime.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "$ref": "common.schema.json#/$defs/record_kind"
    },
    "execution_enabled": {
      "type": "boolean"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "task_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "original_text": {
      "type": "string",
      "minLength": 1
    },
    "input_versions": {
      "type": "object",
      "properties": {
        "material_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "boundary_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "feature_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "global_representation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "material_version",
        "boundary_version",
        "feature_version",
        "global_representation_version"
      ],
      "additionalProperties": false
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/trusted_actor",
      "properties": {
        "role": {
          "const": "operator"
        }
      }
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "source": {
      "enum": [
        "authenticated_human_ui",
        "authenticated_user_message"
      ]
    },
    "is_final_decision": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "execution_enabled",
    "observation_id",
    "task_contract_id",
    "item_ids",
    "original_text",
    "input_versions",
    "actor",
    "recorded_at",
    "source",
    "is_final_decision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "engineering_simulation"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "execution_enabled": {
            "const": false
          }
        }
      }
    }
  ]
}
