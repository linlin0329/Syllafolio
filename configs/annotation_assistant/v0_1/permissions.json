  "assistant_condition_rule": "assistant role requires condition.assistant_enabled=true and assistant_orchestration capability",
  "comparison_design_rules": {
    "assistant_increment": "paired conditions differ only in assistant_enabled and assistant_orchestration; acoustic capabilities, materials, presets and timing remain matched",
